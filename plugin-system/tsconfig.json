{
  "extends": "../tsconfig.base.json",
  // Includes JSON just for test compilation/test files
  "include": ["src", "src/**/*.json"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "@rafaysystems/plugin-system": ["./src"],
      "@rafaysystems/plugin-system/*": ["./src/*"],
      "@rafaysystems/components/compat/icons": ["../components/dist/compat/icons"],
      "@rafaysystems/components/compat/mui": ["../components/dist/compat/mui"]
    }
  }
}

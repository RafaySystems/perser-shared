{
  "name": "@rafaysystems/plugin-system",
  "version": "0.54.0-rc.11",
  "description": "The plugin feature in Pereses",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/perses.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "module": "dist/index.js",
  "main": "dist//cjs/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "npm run clean && concurrently \"npm:build:*\"",
    "build:cjs": "swc ./src -d dist/cjs --strip-leading-paths --config-file ../.cjs.swcrc",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"npm:build:* -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC jest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint --fix src --ext .ts,.tsx"
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.6.0",
    "@rafaysystems/components": "0.54.0-rc.8",
    "@perses-dev/core": "0.53.0",
    "@perses-dev/spec": "0.2.0-beta.9",
    "@rafaysystems/client": "0.54.0-rc.8",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "immer": "^10.1.1",
    "recharts": "^3.8.1",
    "react-hook-form": "^7.46.1",
    "use-query-params": "^2.2.1",
    "zod": "^3.25.76",
    "semver": "^7.8.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.2.0",
    "@tanstack/react-query": "^4.39.1",
    "@xyflow/react": "^12.0.0",
    "leaflet": "^1.9.4",
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/semver": "^7.7.1",
    "@xyflow/react": "^12.6.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1"
  },
  "files": [
    "dist"
  ]
}

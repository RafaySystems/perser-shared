{
  "name": "@rafaysystems-perses/dashboards",
  "version": "0.54.0-rc.1",
  "description": "The dashboards feature in Perses",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/perses.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "module": "dist/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "concurrently \"npm:build:*\"",
    "build:cjs": "swc ./src -d dist/cjs --strip-leading-paths --config-file ../.cjs.swcrc",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"npm:build:* -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC jest",
    "test:watch": "npm run test -- --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint --fix src --ext .ts,.tsx"
  },
  "dependencies": {
    "@rafaysystems-perses/components": "0.54.0-rc.0",
    "@rafaysystems-perses/plugin-system": "0.54.0-rc.0",
    "@perses-dev/spec": "0.2.0-beta.9",
    "@rafaysystems-perses/client": "0.54.0-rc.0",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-hotkeys": "^0.9.1",
    "immer": "^10.1.1",
    "react-grid-layout": "^1.3.4",
    "react-hook-form": "^7.46.1",
    "react-intersection-observer": "^9.4.0",
    "use-immer": "^0.11.0",
    "use-query-params": "^2.2.1",
    "use-resize-observer": "^9.0.0",
    "yaml": "^2.7.0",
    "zustand": "^4.3.3"
  },
  "devDependencies": {
    "@types/react-grid-layout": "^1.3.6",
    "history": "^5.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^4.39.1",
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0"
  },
  "files": [
    "dist"
  ]
}
